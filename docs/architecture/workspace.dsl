// Auto-generated by Project Varuna (AST + Centrality Pruning + Louvain Community Detection)
workspace "project-varuna" "Automated C4 Architecture Model (Modularity Q=0.40, Alignment=100%)" {
  !identifiers hierarchical

  model {
    consumer = person "Developer / API Consumer" "Invokes CLI commands, HTTP endpoints, or public entrypoints"

    external_http_llm_apis = softwareSystem "External HTTP / LLM APIs" "External API & LLM gateway client" "External"
    tree_sitter_ast_runtime = softwareSystem "Tree-sitter AST Runtime" "Multi-language incremental AST parser" "External"
    networkx_graph_runtime = softwareSystem "NetworkX Graph Runtime" "Graph topology & Louvain community engine" "External"

    project_varuna = softwareSystem "project-varuna" "Automated C4 model (Modularity Q=0.40, Alignment=100%)" {
      core_app = container "project-varuna Application" "Primary application runtime containing Louvain-discovered C3 components" "Python" {
        comp_cli = component "CLI Pipeline Orchestrator" "Provides command-line entrypoints and coordinates the end-to-end architectural analysis workflow." "Python · Typer / CLI" {
          properties {
            "varuna.cohesion" "0%"
            "varuna.dominant_namespace" "cli"
            "varuna.module_count" "1"
            "c4.module.cli" "src/varuna/cli.py (in=0, out=4, PR=0.053)"
          }
        }
        comp_extractors = component "Source and Spec Extractors" "Parses source code ASTs, API specifications, and infrastructure configurations into architectural symbols and dependencies." "Python" {
          properties {
            "varuna.cohesion" "100%"
            "varuna.dominant_namespace" "extractors"
            "varuna.module_count" "7"
            "c4.module.base" "src/varuna/extractors/base.py (in=6, out=1, PR=0.053)"
            "c4.module.infra_scanner" "src/varuna/extractors/infra_scanner.py (in=2, out=2, PR=0.053)"
            "c4.module.openapi_parser" "src/varuna/extractors/openapi_parser.py (in=1, out=2, PR=0.053)"
            "c4.module.python_extractor" "src/varuna/extractors/python_extractor.py (in=1, out=2, PR=0.053)"
            "c4.module.registry" "src/varuna/extractors/registry.py (in=1, out=7, PR=0.053)"
            "c4.module.ruby_extractor" "src/varuna/extractors/ruby_extractor.py (in=1, out=2, PR=0.053)"
            "c4.module.ts_extractor" "src/varuna/extractors/ts_extractor.py (in=1, out=2, PR=0.053)"
          }
        }
        comp_emitters = component "Architecture DSL Emitters" "Generates LikeC4, Structurizr DSL, and Markdown drift reports from the analyzed architectural graph." "Python" {
          properties {
            "varuna.cohesion" "100%"
            "varuna.dominant_namespace" "emitters"
            "varuna.module_count" "4"
            "c4.module.emitters" "src/varuna/emitters/__init__.py (in=1, out=3, PR=0.053)"
            "c4.module.likec4_emitter" "src/varuna/emitters/likec4_emitter.py (in=1, out=1, PR=0.053)"
            "c4.module.report_emitter" "src/varuna/emitters/report_emitter.py (in=1, out=1, PR=0.053)"
            "c4.module.structurizr_emitter" "src/varuna/emitters/structurizr_emitter.py (in=1, out=1, PR=0.053)"
          }
        }
        comp_graph = component "Dependency Graph Engine" "Constructs dependency networks and applies graph algorithms to compute centrality, detect communities, and measure drift." "Python" {
          properties {
            "varuna.cohesion" "60%"
            "varuna.dominant_namespace" "graph"
            "varuna.module_count" "4"
            "c4.module.builder" "src/varuna/graph/builder.py (in=1, out=6, PR=0.053)"
            "c4.module.centrality" "src/varuna/graph/centrality.py (in=1, out=1, PR=0.053)"
            "c4.module.clustering" "src/varuna/graph/clustering.py (in=1, out=1, PR=0.053)"
            "c4.module.drift" "src/varuna/graph/drift.py (in=1, out=1, PR=0.053)"
          }
        }
        comp_enrichment = component "Semantic Component Enricher" "Infers meaningful names and descriptions for discovered components using heuristic metrics and LLM synthesis." "Python" {
          properties {
            "varuna.cohesion" "100%"
            "varuna.dominant_namespace" "enrichment"
            "varuna.module_count" "2"
            "c4.module.heuristic_namer" "src/varuna/enrichment/heuristic_namer.py (in=1, out=1, PR=0.053)"
            "c4.module.llm_agent" "src/varuna/enrichment/llm_agent.py (in=1, out=2, PR=0.053)"
          }
        }
        comp_models = component "Graph Data Models" "Defines domain schemas, node representations, and edge classifications for the architectural knowledge graph." "Python · Shared Schema / Sink" {
          properties {
            "varuna.cohesion" "100%"
            "varuna.dominant_namespace" "models"
            "varuna.module_count" "1"
            "c4.module.graph_schema" "src/varuna/models/graph_schema.py (in=17, out=0, PR=0.053)"
          }
        }
      }
    }

    // --- Actor to Entrypoint Relationships ---
    consumer -> project_varuna.core_app.comp_cli "cli:analyze, cli:inspect"

    // --- C3 Inter-Component Dependencies (Louvain Aggregated) ---
    project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_emitters "Depends on (w=2.9)"
    project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_enrichment "Depends on (w=3.6)"
    project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_graph "Depends on (w=4.6)"
    project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_models "Depends on (w=3.6)"
    project_varuna.core_app.comp_extractors -> project_varuna.core_app.comp_models "Depends on (w=46.2)"
    project_varuna.core_app.comp_emitters -> project_varuna.core_app.comp_models "Depends on (w=10.2)"
    project_varuna.core_app.comp_graph -> project_varuna.core_app.comp_extractors "Depends on (w=6.0)"
    project_varuna.core_app.comp_graph -> project_varuna.core_app.comp_models "Depends on (w=24.4)"
    project_varuna.core_app.comp_enrichment -> project_varuna.core_app.comp_models "Depends on (w=6.2)"

    // --- C3 Component to External & Datastore Boundaries ---
    project_varuna.core_app.comp_extractors -> tree_sitter_ast_runtime "Uses" "Native C / Tree-sitter"
    project_varuna.core_app.comp_graph -> networkx_graph_runtime "Uses" "NetworkX / SciPy"
    project_varuna.core_app.comp_enrichment -> external_http_llm_apis "Uses" "HTTPS / REST"
  }

  views {
    systemContext project_varuna "c1_context" {
      title "C1 - System Context: project-varuna"
      include *
      autoLayout
    }

    container project_varuna "c2_containers" {
      title "C2 - Container View: project-varuna"
      include *
      autoLayout
    }

    component project_varuna.core_app "c3_components" {
      title "C3 - Louvain Components: project-varuna"
      include *
      autoLayout
    }

    styles {
      element "Person" {
        shape Person
        background #08427b
        color #ffffff
      }
      element "Software System" {
        background #1168bd
        color #ffffff
      }
      element "External" {
        background #999999
        color #ffffff
      }
      element "Container" {
        background #438dd5
        color #ffffff
      }
      element "Component" {
        background #85bbf0
        color #000000
      }
      element "Database" {
        shape Cylinder
      }
      element "Queue" {
        shape Pipe
      }
    }
  }
}
