// Auto-generated by Project Varuna (AST + Centrality Pruning + Louvain Community Detection)
specification {
  element actor {
    style {
      shape person
      color green
    }
  }
  element system
  element container
  element component
  element module {
    style {
      color slate
    }
  }
  element database {
    style {
      shape cylinder
      color indigo
    }
  }
  element queue {
    style {
      shape queue
      color amber
    }
  }
  element external_system {
    style {
      color muted
    }
  }
}

model {
  consumer = actor 'Developer / API Consumer' {
    description 'Invokes CLI commands, HTTP endpoints, or public entrypoints'
  }

  external_http_llm_apis = external_system 'External HTTP / LLM APIs' {
    technology 'HTTPS / REST'
    description 'External API & LLM gateway client'
  }
  tree_sitter_ast_runtime = external_system 'Tree-sitter AST Runtime' {
    technology 'Native C / Tree-sitter'
    description 'Multi-language incremental AST parser'
  }
  networkx_graph_runtime = external_system 'NetworkX Graph Runtime' {
    technology 'NetworkX / SciPy'
    description 'Graph topology & Louvain community engine'
  }

  project_varuna = system 'project-varuna' {
    description 'Automated C4 model (Modularity Q=0.28, Alignment=100%)'

    core_app = container 'project-varuna Application' {
      technology 'Python'
      description 'Primary application runtime containing Louvain-discovered C3 components'

      comp_cli = component 'CLI & Orchestration Entrypoint' {
        technology 'Python · Typer / CLI'
        description 'Typer + Rich CLI and pipeline orchestrator for Project Varuna.'
        mod_cli_src_varuna_cli = module 'cli' {
          technology 'src/varuna/cli.py'
          description 'Typer + Rich CLI and pipeline orchestrator for Project Varuna.'
        }
      }

      comp_extractors = component 'AST & Spec Extractors' {
        technology 'Python'
        description 'Base Tree-sitter AST extractor interface and path normalization helpers (7 modules).'
        mod_base_src_varuna_extractors_base = module 'base' {
          technology 'src/varuna/extractors/base.py'
          description 'Base Tree-sitter AST extractor interface and path normalization helpers.'
        }
        mod_infra_scanner_src_varuna_extractors_infra_scanner = module 'infra_scanner' {
          technology 'src/varuna/extractors/infra_scanner.py'
          description 'Scans infrastructure files and dependency manifests to identify C2 datastores, queues, and C1 external systems.'
        }
        mod_openapi_parser_src_varuna_extractors_openapi_parser = module 'openapi_parser' {
          technology 'src/varuna/extractors/openapi_parser.py'
          description 'Optional OpenAPI 3.x / Swagger 2.0 parser and route-to-code merger.'
        }
        mod_python_extractor_src_varuna_extractors_python_extractor = module 'python_extractor' {
          technology 'src/varuna/extractors/python_extractor.py'
          description 'Tree-sitter AST extractor for Python source code, FastAPI/Flask/Django routes, and Typer/Click CLIs.'
        }
        mod_registry_src_varuna_extractors_registry = module 'registry' {
          technology 'src/varuna/extractors/registry.py'
          description 'Unified Extractor Registry that coordinates AST, OpenAPI, and Infrastructure extraction.'
        }
        mod_ruby_extractor_src_varuna_extractors_ruby_extractor = module 'ruby_extractor' {
          technology 'src/varuna/extractors/ruby_extractor.py'
          description 'Tree-sitter AST extractor for Ruby/Rails, including Zeitwerk constant resolution, associations, and routes.'
        }
        mod_ts_extractor_src_varuna_extractors_ts_extractor = module 'ts_extractor' {
          technology 'src/varuna/extractors/ts_extractor.py'
          description 'Tree-sitter AST extractor for TypeScript/JavaScript, Express/Fastify routes, and NestJS decorators.'
        }
      }

      comp_graph = component 'Network Science & Graph Engine' {
        technology 'Python'
        description 'NetworkX dependency graph builder and unified graph-science pipeline coordinator (4 modules).'
        mod_builder_src_varuna_graph_builder = module 'builder' {
          technology 'src/varuna/graph/builder.py'
          description 'NetworkX dependency graph builder and unified graph-science pipeline coordinator.'
        }
        mod_centrality_src_varuna_graph_centrality = module 'centrality' {
          technology 'src/varuna/graph/centrality.py'
          description 'Network science centrality metrics, topological entrypoint inference, and utility sink detection.'
        }
        mod_clustering_src_varuna_graph_clustering = module 'clustering' {
          technology 'src/varuna/graph/clustering.py'
          description 'Louvain community detection engine for discovering C3 architectural components.'
        }
        mod_drift_src_varuna_graph_drift = module 'drift' {
          technology 'src/varuna/graph/drift.py'
          description 'Architecture Drift Analyzer: compares folder boundaries against Louvain communities.'
        }
      }

      comp_emitters = component 'LikeC4 & Report Emitters' {
        technology 'Python'
        description 'Generates valid, hierarchical LikeC4 DSL (.c4) files across C1, C2, C3, and C4 zoom levels (2 modules).'
        mod_likec4_emitter_src_varuna_emitters_likec4_emitter = module 'likec4_emitter' {
          technology 'src/varuna/emitters/likec4_emitter.py'
          description 'Generates valid, hierarchical LikeC4 DSL (.c4) files across C1, C2, C3, and C4 zoom levels.'
        }
        mod_report_emitter_src_varuna_emitters_report_emitter = module 'report_emitter' {
          technology 'src/varuna/emitters/report_emitter.py'
          description 'Generates a Markdown Architecture & Modularity Drift Report with embedded Mermaid C3 diagrams.'
        }
      }

      comp_enrichment = component 'Semantic Enrichment & Naming' {
        technology 'Python'
        description 'Deterministic TF-IDF, docstring, and symbol-based C3 component namer (zero-API-key default) (2 modules).'
        mod_heuristic_namer_src_varuna_enrichment_heuristic_namer = module 'heuristic_namer' {
          technology 'src/varuna/enrichment/heuristic_namer.py'
          description 'Deterministic TF-IDF, docstring, and symbol-based C3 component namer (zero-API-key default).'
        }
        mod_llm_agent_src_varuna_enrichment_llm_agent = module 'llm_agent' {
          technology 'src/varuna/enrichment/llm_agent.py'
          description 'Optional LLM Agent for semantic C3 component synthesis (supports Gemini, OpenAI, and Anthropic).'
        }
      }

      comp_models = component 'Core Graph Schema & Models' {
        technology 'Python · Shared Schema / Sink'
        description 'Core Pydantic schema definitions for C1-C4 architectural graphs, metrics, and drift analysis.'
        mod_graph_schema_src_varuna_models_graph_schema = module 'graph_schema' {
          technology 'src/varuna/models/graph_schema.py'
          description 'Core Pydantic schema definitions for C1-C4 architectural graphs, metrics, and drift analysis.'
        }
      }

    }
  }

  // --- Actor to Entrypoint Relationships ---
  consumer -> project_varuna.core_app.comp_cli 'cli:analyze, cli:inspect'

  // --- C3 Inter-Component Dependencies (Louvain Aggregated) ---
  project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_emitters 'Depends on (w=7.2)'
  project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_enrichment 'Depends on (w=3.6)'
  project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_graph 'Depends on (w=4.6)'
  project_varuna.core_app.comp_cli -> project_varuna.core_app.comp_models 'Depends on (w=3.6)'
  project_varuna.core_app.comp_extractors -> project_varuna.core_app.comp_models 'Depends on (w=46.2)'
  project_varuna.core_app.comp_graph -> project_varuna.core_app.comp_extractors 'Depends on (w=6.0)'
  project_varuna.core_app.comp_graph -> project_varuna.core_app.comp_models 'Depends on (w=24.4)'
  project_varuna.core_app.comp_emitters -> project_varuna.core_app.comp_models 'Depends on (w=6.2)'
  project_varuna.core_app.comp_enrichment -> project_varuna.core_app.comp_models 'Depends on (w=6.2)'

  // --- C3 Component to External & Datastore Boundaries ---
  project_varuna.core_app.comp_extractors -> tree_sitter_ast_runtime 'Uses (Native C / Tree-sitter)'
  project_varuna.core_app.comp_graph -> networkx_graph_runtime 'Uses (NetworkX / SciPy)'
  project_varuna.core_app.comp_enrichment -> external_http_llm_apis 'Uses (HTTPS / REST)'

